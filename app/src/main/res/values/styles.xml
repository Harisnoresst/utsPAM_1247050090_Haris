<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KopiDanNyemil" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:colorAccent">@color/brown</item>
        <item name="colorPrimary">@color/charcoal</item>
    </style>

    <!-- Layar Welcome berlatar gelap: status bar & navigation bar ikut gelap -->
    <style name="Theme.KopiDanNyemil.Welcome">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/charcoal</item>
        <item name="android:navigationBarColor">@color/charcoal</item>
    </style>

    <!-- Induk kosong untuk style bertitik (App.*, App.Text.*) -->
    <style name="App" />
    <style name="App.Text" />

    <!-- ===== Tipografi ===== -->
    <style name="App.Text.Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/brown</item>
    </style>

    <style name="App.Text.Pill" parent="App.Text.Label">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="App.Text.Title">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <style name="App.Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="App.Text.FieldLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/charcoal</item>
    </style>

    <style name="App.Text.Back">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawableStart">@drawable/ic_arrow_back</item>
        <item name="android:drawableTint">@color/muted</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Komponen ===== -->
    <style name="App.Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Tombol: pakai atribut MaterialButton (android:background diabaikan oleh MaterialButton) -->
    <style name="App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/brown</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>

    <style name="App.Button.Outline" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/paper</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">#1F00704A</item>
    </style>

    <style name="App.Button.Light" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">#331E3932</item>
    </style>

    <style name="App.Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/charcoal</item>
    </style>

    <style name="App.NavItem">
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
</resources>